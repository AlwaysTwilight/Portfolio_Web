GEMINI_API_KEY=
LLAMA_CLOUD_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GROQ_CHAT_MODEL=llama-3.1-8b-instant
OPENROUTER_CHAT_MODEL=qwen/qwen-2.5-7b-instruct
# ── Primary datastore: Postgres + pgvector (vectors AND metadata) ──
# Local docker-compose sets this automatically. For production, paste your
# Neon connection string here (include ?sslmode=require).
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/portfolio?sslmode=require
DATABASE_URL=

# Collection namespace within the rag_chunks table.
CHROMA_COLLECTION_NAME=documents_gemini

PORT=8000
RAW_UPLOAD_DIR=data/raw
PROCESSED_DIR=data/processed
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
ADMIN_TOKEN=

# ── Legacy fallbacks (only used when DATABASE_URL is empty) ──
# Chroma vector store + SQLite/Mongo metadata. Leave unset when using Postgres.
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SPACE=cosine
SQLITE_PATH=data/metadata/app.db
MONGODB_URI=
MONGODB_DB=portfolio
CORS_ALLOW_ORIGINS=https://your-portfolio.vercel.app,https://your-admin.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# EC2 reverse-proxy / domain setup (used by docker-compose.ec2.yml + Caddyfile)
CADDY_EMAIL=
PORTFOLIO_HOST=yourdomain.com
ADMIN_HOST=admin.yourdomain.com
API_HOST=api.yourdomain.com

# ChromaDB service is provided by docker-compose*.yml
